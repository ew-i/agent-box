#!/usr/bin/env bash
# agentbox: run a coding agent in an isolated container with only the current folder mounted.
# Usage: agentbox [flags] [command...]   (default: bash)   e.g. `agentbox -p python claude`, see --help
set -euo pipefail

engine="${AGENTBOX_ENGINE:-docker}"
home_volume="${AGENTBOX_HOME_VOLUME:-agent-box-home}"
env_file="${AGENTBOX_ENV_FILE:-$HOME/.config/agent-box/env}"

usage() {
  cat <<'USAGE'
Usage: agentbox [flags] [command...]   (default: bash)

Flags (before the command):
  -d, --docker         Docker inside the sandbox (privileged, see README)
      --php            PHP image (agent-box:php, or agent-box:php-docker with -d)
  -p, --presets LIST   mise toolchain presets, e.g. node,python
  -h, --help           show this help

e.g. agentbox --php -d -p node,python claude
USAGE
}

# AGENTBOX_DOCKER=1 / AGENTBOX_PRESETS are the defaults, flags override them
case "${AGENTBOX_DOCKER:-0}" in
  1|true|yes) with_docker=1 ;;
  *)          with_docker=0 ;;
esac
with_php=0
presets="${AGENTBOX_PRESETS:-}"

# Flags end at the first non-flag, so `agentbox claude --resume` passes --resume to claude
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--docker)  with_docker=1 ;;
    --php)        with_php=1 ;;
    -p|--presets) [[ $# -ge 2 ]] || { echo "agentbox: $1 needs a value, e.g. node,python" >&2; exit 2; }
                  presets="$2"; shift ;;
    -h|--help)    usage; exit 0 ;;
    --)           shift; break ;;
    -*)           echo "agentbox: unknown flag $1 (see agentbox --help)" >&2; exit 2 ;;
    *)            break ;;
  esac
  shift
done

# Image tag from the flags: agent-box, :php, :docker or :php-docker; AGENTBOX_IMAGE overrides it
tag=""
[[ $with_php -eq 1 ]] && tag="php"
[[ $with_docker -eq 1 ]] && tag="${tag:+$tag-}docker"
image="${AGENTBOX_IMAGE:-agent-box${tag:+:$tag}}"

# Mounting $HOME or a folder above it would hand the agent ~/.ssh, cloud credentials and every project
here="$(pwd -P)"
home="$(cd "$HOME" && pwd -P)"
if [[ "$home/" == "${here%/}/"* ]]; then
  echo "agentbox: refusing to mount $here, it contains your home folder; cd into a project folder first" >&2
  exit 2
fi

# Names made safe for Docker: the folder name for the mount path, parent + folder for the
# container (~/work/api: agent-box-work-api), and for the Docker-mode volume a hash of
# the full path, so two projects with the same folder name never share one
name="${here##*/}"
name="${name//[^a-zA-Z0-9_.-]/-}"
name="${name:-root}"
parent="${here%/*}"
parent="${parent##*/}"
parent="${parent//[^a-zA-Z0-9_.-]/-}"
container="agent-box-${parent:+$parent-}$name"
sum="$(printf %s "$here" | cksum)"
docker_volume="agent-box-docker-$name-$(printf %08x "${sum%% *}")"

# -v splits on ':', so a folder path with one needs --mount, which splits on ',' instead
if [[ "$here" == *:* ]]; then
  project_mount=(--mount "type=bind,src=$here,dst=/workspace/$name")
else
  project_mount=(-v "$here:/workspace/$name")
fi

args=(run -it --rm
  --name "$container"
  --hostname "$container"
  -v "$home_volume:/home/agent-box"
  "${project_mount[@]}"
  -w "/workspace/$name")

if [[ $with_docker -eq 1 ]]; then
  # Inner Docker's images and containers, one volume per project; 30s so dockerd
  # can stop its containers on docker stop (the default 10s kills it midway)
  args+=(--privileged --init --stop-timeout 30 -v "$docker_volume:/var/lib/docker")
fi

# Presets (java,go): mise toolchains, installed on first use
if [[ -n "$presets" ]]; then
  args+=(-e "MISE_ENV=$presets")
fi

if [[ -f "$env_file" ]]; then
  args+=(--env-file "$env_file")
fi

# Extra engine flags, split on whitespace, e.g. AGENTBOX_OPTS="-p 3000:3000"
if [[ -n "${AGENTBOX_OPTS:-}" ]]; then
  read -r -a extra <<< "$AGENTBOX_OPTS"
  # ${a[@]+...}: bash 3.2 (macOS) treats an empty array as unbound under set -u
  args+=(${extra[@]+"${extra[@]}"})
fi

if [[ $# -eq 0 ]]; then
  set -- bash
fi

exec "$engine" "${args[@]}" "$image" "$@"
