# The `dev` box from ~/.config/agentbox/profiles.toml. Pick the project to mount, e.g.
#   make start WORKSPACE=~/code/my-app
NAME ?= dev
# Required: mount one project. The agent can write to it, .git hooks included, which run on the
# host. READONLY=1 mounts it read-only, which even root in the box can't undo.
WORKSPACE ?= $(error set WORKSPACE, e.g. make start WORKSPACE=~/code/my-app)
READONLY ?=
# Optional: loaded when it exists, e.g. one line OPENROUTER_API_KEY=sk-or-... (chmod 600 it).
ENV_FILE ?= $(HOME)/.config/agentbox/.env

.PHONY: start exec stop del

start:
	uv run $(if $(wildcard $(ENV_FILE)),--env-file $(ENV_FILE)) agentbox up dev --name $(NAME) -w $(WORKSPACE) $(if $(READONLY),--readonly)
exec:
	uv run msb exec $(NAME) -- /bin/bash
stop:
	uv run msb stop $(NAME)
del:
	uv run agentbox down $(NAME)
